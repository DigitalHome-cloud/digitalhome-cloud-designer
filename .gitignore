# Dependencies
node_modules/

# Gatsby
.cache/
public/

# Build
build/

# Env — never commit
.env*

# Amplify Gen 2 — local sandbox state, never commit
.amplify/
# amplify_outputs.json is generated per-branch by the Hosting build's
# preBuild step (`ampx generate outputs`); committing it would ship one
# environment's IDs into another. Local dev keeps a sandbox-pointed copy
# untracked.
src/amplify_outputs.json

# Legacy Gen 1 leftovers (kept ignored just in case any old branch still
# references these paths)
src/aws-exports.js
src/aws-exports.deployment.js

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
