# Dependencies
node_modules/

# Gatsby
.cache/
public/

# Build
build/

# Env — never commit
.env*

# Amplify Gen 2 — local sandbox state, never commit
.amplify/
# (amplify_outputs.json IS committed — it holds the public Cognito/AppSync IDs
# that the frontend needs to talk to the deployed backend.)

# Legacy Gen 1 leftovers (kept ignored just in case any old branch still
# references these paths)
src/aws-exports.js
src/aws-exports.deployment.js

# OS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
